# =====================================================================
# Meme Coin Cabal Scanner - Environment Variables Template
# Copy this file to '.env' in the same directory and fill in your keys.
# =====================================================================

# 1. Solana RPC Endpoint (Required for real Solana mainnet scans)
# Public RPCs (like https://api.mainnet-beta.solana.com) are heavily rate-limited.
# Recommend getting a free/pro RPC key from Helius (https://helius.dev) or Quicknode.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# 2. OpenAI API Key (Required for real Swarms AI Agent execution)
# The Swarms SDK uses this key to drive the GPT-4o model for contract decision audits.
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
